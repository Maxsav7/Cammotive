# Camotive environment. Set these in Vercel → Project → Settings → Environment
# Variables (Production). Never commit real values. Online booking stays OFF,
# and customers see "call or text", until every required value below is valid.
# Generate secrets with: openssl rand -hex 32   (a different value for each)

# --- Switches (set both to true only after the staging test in VERCEL.md) ---
BOOKING_ENABLED=false
BOOKING_SCHEDULER_READY=false

# --- Site ---
# Exact public origin: https, no trailing slash. Must match the browser's Origin header.
BOOKING_ORIGIN=https://www.camotivedetailing.com

# --- Bot protection: Cloudflare Turnstile widget for the hostname above ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Secrets (openssl rand -hex 32) ---
# 64 hex characters. Changing it later makes existing bookings unreadable.
BOOKING_ENCRYPTION_KEY=
# At least 32 characters. Changing it invalidates emailed appointment links.
BOOKING_HASH_SECRET=
# At least 32 characters. For any external scheduler that POSTs to the maintenance endpoint.
BOOKING_CRON_SECRET=
# At least 32 characters. Vercel Cron sends this automatically to the maintenance endpoint.
CRON_SECRET=

# --- Email (Resend). The sender must be on a domain you verified in Resend. ---
RESEND_API_KEY=
BOOKING_FROM_EMAIL=Camotive Detailing <bookings@camotivedetailing.com>
# Where Cam receives new-booking notifications (his everyday inbox; use 2FA on it).
# For your own test run, put your email here first, then switch it to Cam's.
CAM_BOOKING_EMAIL=

# --- Database: Cloudflare D1, reached over its REST API from Vercel ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
# API token scoped to D1 edit on this account only (not the Global API Key).
CLOUDFLARE_D1_API_TOKEN=

# --- Google Calendar sync (optional). Leave all three empty to turn it off. ---
# Service account that Cam shared his calendar with ("Make changes to events").
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The private_key value from the service account's JSON key (literal \n is fine).
GOOGLE_SERVICE_ACCOUNT_KEY=
# Calendar ID from Google Calendar → Settings and sharing → Integrate calendar.
GOOGLE_CALENDAR_ID=
